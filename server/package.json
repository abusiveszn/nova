    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
